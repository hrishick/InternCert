{
  "name": "interncert-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:worker": "npm run build && npx wrangler deploy",
    "deploy:pages": "npm run build && npx wrangler pages deploy frontend/dist --project-name=interncert",
    "d1:create": "npx wrangler d1 create interncert-d1",
    "d1:migrate": "npx wrangler d1 execute interncert-d1 --remote --file=./database/schema.sql",
    "d1:seed": "npx wrangler d1 execute interncert-d1 --remote --file=./database/seed.sql",
    "r2:create": "npx wrangler r2 bucket create interncert-certificates"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "hono": "^4.13.13"
  }
}
