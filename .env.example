# ===================================================================
# INTERNCERT PLATFORM CONFIGURATION
# ===================================================================

# 1. Server Configuration
PORT=8787
NODE_ENV=development
JWT_SECRET=interncert-secret-key-change-me-in-prod-2026

# 2. Real Email Dispatch (Nodemailer SMTP / Gmail / Custom Mail Server)
# Option A: Gmail (Recommended & Fastest):
#   1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
#   2. Generate an "App Password" at: myaccount.google.com/apppasswords
#   3. Fill in your Gmail and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="InternCert Certification Cell <your_email@gmail.com>"

# Option B: Custom SMTP / SendGrid / Brevo / Mailgun / AWS SES
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_api_key_here
# SMTP_FROM="InternCert <certificates@yourdomain.com>"

# 3. Cloudflare D1 & R2 (Optional for cloud production deployment)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=interncert-certificates
